# TIGER (LSH IDs) on MovieLens-1M -- TIGER's encoder-decoder trained on codes
# from Locality-Sensitive Hashing (SimHash) of the item content embeddings, as
# an alternative to RQ-VAE. The item content (title + genres) is encoded with
# the same sentence-T5 model used by the main pipeline, so only the quantization
# scheme differs.
#
# NOTE: codebook_size must be a power of two for the SimHash bit-packing.

run_baseline.model = "tiger_lsh"
run_baseline.dataset = "ml-1m"
run_baseline.ks = [5, 10, 50, 100]
run_baseline.seed = 42
run_baseline.device = "gpu"

# Decoding for long recommendation lists.
# gen_mode="sample": stochastic autoregressive sampling -> large candidate pool
#   (supports k = 50, 100, ...). gen_mode="beam": exact, but only for small k.
# num_samples=None auto-scales the pool to comfortably cover max(ks).
# temperature > 1 flattens the distribution (more diverse candidates).
run_baseline.gen_mode = "sample"
run_baseline.num_samples = None
run_baseline.temperature = 1.0

# Semantic-ID structure.
run_baseline.n_layers = 3
run_baseline.codebook_size = 256

# Optimisation (epochs == number of optimisation steps / batches).
# MovieLens histories are long, so a larger context than the Amazon default
# (20) is used.
run_baseline.max_len = 200
run_baseline.epochs = 20000
run_baseline.lr = 0.001
run_baseline.batch_size = 256
run_baseline.weight_decay = 0.01
run_baseline.warmup_steps = 10000

# T5 encoder-decoder size (matches configs/decoder_ml1m.gin scale).
run_baseline.t5_d_model = 128
run_baseline.t5_num_heads = 6
run_baseline.t5_d_ff = 1024
run_baseline.t5_num_layers = 4
